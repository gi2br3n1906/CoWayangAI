# Node backend + browser FOH production scope.
# Local development may leave HOST/PORT at defaults and use Vite's proxy.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
FOH_ONLY_MODE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Production replaces these with the VPS values in deploy/backend.production.env.example.
# GOOGLE_APPLICATION_CREDENTIALS=/etc/cowayangai/firebase-admin.json
