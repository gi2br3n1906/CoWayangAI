# Copy this file to .env in this directory. Never commit .env.
# Local mode: Node backend and worker run on this PC.
OPERATION_MODE=local
COWAYANG_SERVER_URL=http://127.0.0.1:3000
NODEJS_WEBHOOK_URL=http://127.0.0.1:3000/api/webhook
WORKER_SHARED_SECRET=
FOH_CAPTURE_ENABLED=true
FOH_CAMERA_INDEX=0
FOH_AUDIO_DEVICE_INDEX=
FOH_PREVIEW_PORT=8002
YOLO_MODEL_PATH=../ai/weight.pt
# Fill this locally. Do not commit or share the actual key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
COWAYANG_ENABLE_SILERO=0

# Hybrid FOH PC: set OPERATION_MODE=hybrid, COWAYANG_SERVER_URL to the public
# backend URL, WORKER_SHARED_SECRET to the same secret as the VPS, and keep
# FOH_CAPTURE_ENABLED=true. Do not expose the local MJPEG port publicly.
