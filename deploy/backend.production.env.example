# Copy to /etc/cowayangai/backend.env on the VPS; never commit the filled file.
NODE_ENV=production
HOST=127.0.0.1
PORT=3010
FOH_ONLY_MODE=true
ALLOWED_ORIGINS=https://cowayangai.site
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GOOGLE_APPLICATION_CREDENTIALS=/etc/cowayangai/firebase-admin.json
