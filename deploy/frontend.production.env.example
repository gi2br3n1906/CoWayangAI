# Copy to /etc/cowayangai/frontend.env on the VPS, fill from Firebase Web App settings.
# The installer copies this file to frontend/.env.production before Vite build.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_API_BASE_URL=
VITE_SOCKET_URL=
VITE_FOH_PREVIEW_URL=
VITE_AI_MAINTENANCE=false
