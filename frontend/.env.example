# Firebase Configuration
# Get these values from your Firebase Console:
# https://console.firebase.google.com/ -> Project Settings -> General -> Your apps -> Web app

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Leave API/socket URLs empty to use the same origin (recommended behind a proxy).
# Local development defaults to the Vite proxy in vite.config.js.
VITE_API_BASE_URL=
VITE_SOCKET_URL=
# Optional local FOH preview only; this loopback URL is not accessible to remote users.
VITE_FOH_PREVIEW_URL=http://127.0.0.1:8002/video-feed

# AI Maintenance Mode (set to 'true' to enable maintenance overlay on AI features)
VITE_AI_MAINTENANCE=false
